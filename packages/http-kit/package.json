{
  "name": "@hmedic/http-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared NestJS/Fastify HTTP plumbing for apps/api and apps/worker: request ids, ProblemDetails, security headers, idempotency, rate limits, internal tokens, health and metrics",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "@hmedic/audit": "workspace:*",
    "@hmedic/communication": "workspace:*",
    "@hmedic/communication-adapters-mock": "workspace:*",
    "@hmedic/communication-adapters-zamanit": "workspace:*",
    "@hmedic/config": "workspace:*",
    "@hmedic/database": "workspace:*",
    "@hmedic/jobs": "workspace:*",
    "@hmedic/kernel": "workspace:*",
    "@hmedic/observability": "workspace:*",
    "@hmedic/provider-credentials": "workspace:*",
    "@hmedic/prescriptions": "workspace:*",
    "@hmedic/secrets": "workspace:*",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-fastify": "11.2.5",
    "fastify": "5.11.3",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2"
  }
}
