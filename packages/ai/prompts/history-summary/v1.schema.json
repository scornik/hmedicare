{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmedic:ai/history-summary/v1",
  "title": "AI history summary output v1",
  "description": "Chronological history items for one patient, most recent first. Every item cites at least one source id from the retrieval set; the server discards any that do not.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "text", "confidence", "sourceIds"],
      "properties": {
        "category": {
          "enum": ["condition", "medication", "procedure", "investigation", "other"]
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    }
  }
}
