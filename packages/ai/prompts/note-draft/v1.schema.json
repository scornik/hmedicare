{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmedic:ai/note-draft/v1",
  "title": "AI note draft output v1",
  "description": "Note section and diagnosis proposals for one encounter. Every suggestion cites at least one source id from the retrieval set; the server discards any that do not.",
  "type": "object",
  "additionalProperties": false,
  "required": ["suggestions"],
  "properties": {
    "suggestions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/suggestion" }
    }
  },
  "$defs": {
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "noteSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suggestionType", "targetSection", "text", "confidence", "sourceIds"],
      "properties": {
        "suggestionType": { "const": "NOTE_SECTION" },
        "targetSection": {
          "enum": ["chief_complaint", "history", "examination", "assessment", "plan"]
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suggestionType", "display", "certainty", "confidence", "sourceIds"],
      "properties": {
        "suggestionType": { "const": "DIAGNOSIS" },
        "display": { "type": "string", "minLength": 1, "maxLength": 300 },
        "codeSystem": { "enum": ["ICD10", "ICD11", "SNOMEDCT"] },
        "code": { "type": "string", "minLength": 1, "maxLength": 32 },
        "certainty": { "enum": ["CONFIRMED", "PROVISIONAL", "DIFFERENTIAL"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      },
      "dependentRequired": { "code": ["codeSystem"] }
    },
    "suggestion": {
      "oneOf": [{ "$ref": "#/$defs/noteSection" }, { "$ref": "#/$defs/diagnosis" }]
    }
  }
}
