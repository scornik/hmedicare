{
  "components": {
    "parameters": {},
    "schemas": {
      "ErrorCode": {
        "enum": [
          "UNAUTHENTICATED",
          "SESSION_REVOKED",
          "FORBIDDEN",
          "CSRF_FAILED",
          "TENANT_CONTEXT_REQUIRED",
          "PATIENT_CONTEXT_REQUIRED",
          "RESOURCE_NOT_FOUND",
          "VALIDATION_FAILED",
          "RATE_LIMITED",
          "IDEMPOTENCY_KEY_REQUIRED",
          "IDEMPOTENCY_REPLAY",
          "IDEMPOTENCY_IN_PROGRESS",
          "IDEMPOTENCY_KEY_REUSED",
          "STALE_VERSION",
          "QUEUE_STATE_CONFLICT",
          "QUEUE_VERSION_CONFLICT",
          "QUEUE_BUSY",
          "CONCURRENCY_RETRY_EXHAUSTED",
          "INVALID_TRANSITION",
          "DUPLICATE_ACTIVE_SERIAL",
          "RECALL_LIMIT_REACHED",
          "CHAMBER_DAY_CLOSED",
          "CHAMBER_DAY_HAS_ACTIVE_CONSULTATION",
          "CAPACITY_EXCEEDED",
          "DUPLICATE_PATIENT_REVIEW_REQUIRED",
          "PRESCRIPTION_NOT_APPROVED",
          "PRESCRIPTION_NOT_EDITABLE",
          "UPLOAD_EXPIRED",
          "CHECKSUM_MISMATCH",
          "CONTENT_TYPE_NOT_ALLOWED",
          "PAYLOAD_TOO_LARGE",
          "DOCUMENT_NOT_AVAILABLE",
          "DOWNLOAD_TOKEN_INVALID",
          "PROVIDER_UNAVAILABLE",
          "FEATURE_DISABLED",
          "AI_REVIEW_REQUIRED",
          "AI_DRAFT_CLOSED",
          "AI_CONSENT_REQUIRED",
          "AI_ACK_VERSION_OUTDATED",
          "AI_CREDENTIAL_DUPLICATE",
          "AI_CREDENTIAL_REVOKED",
          "INVALID_CREDENTIAL",
          "QUOTA_EXHAUSTED",
          "MODEL_UNAVAILABLE",
          "CONTENT_BLOCKED",
          "SCHEMA_INVALID",
          "TIMEOUT",
          "PROVIDER_ERROR",
          "PHI_MINIMIZATION_FAILED",
          "POLICY_BLOCKED",
          "PAYMENT_NOT_REQUIRED",
          "FEE_NOT_CONFIGURED",
          "PAYMENT_METHOD_UNAVAILABLE",
          "PAYMENT_ALREADY_PAID",
          "PAYMENT_INTENT_EXPIRED",
          "PAYMENT_GATEWAY_REJECTED",
          "PAYMENT_GATEWAY_UNAVAILABLE",
          "MERCHANT_CREDENTIAL_INVALID",
          "REFUND_NOT_ALLOWED",
          "SMS_CREDENTIAL_INVALID",
          "MEDDATA_CHECKSUM_MISMATCH",
          "MEDDATA_SCHEMA_UNSUPPORTED",
          "MEDDATA_IMPORT_IN_PROGRESS",
          "PLATFORM_CONTEXT_REQUIRED",
          "DATA_INTEGRITY_ERROR",
          "INTERNAL_ERROR"
        ],
        "type": "string"
      },
      "FieldError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "code",
          "message"
        ],
        "type": "object"
      },
      "HealthLive": {
        "properties": {
          "app": {
            "enum": [
              "api",
              "worker"
            ],
            "type": "string"
          },
          "bootId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          },
          "uptimeSeconds": {
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "app",
          "bootId",
          "version",
          "uptimeSeconds"
        ],
        "type": "object"
      },
      "HealthReady": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "degraded",
                "fail"
              ],
              "type": "string"
            },
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "degraded",
              "unavailable"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "description": "Error body for every non-2xx response (API-IMPLEMENTATION §1)",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          "fieldErrors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "message": {
            "description": "Safe, localizable message key (never PHI)",
            "type": "string"
          },
          "requestId": {
            "example": "01a0b422-fd6f-7480-8586-444e7fc66080",
            "format": "uuid",
            "type": "string"
          },
          "retryAfterSeconds": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "type": "object"
      },
      "ResponseMeta": {
        "properties": {
          "replayed": {
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "requestId": {
            "example": "01a0b422-fd6f-7480-8586-444e7fc66080",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "requestId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "Access token (EdDSA JWT). Web keeps it in memory; mobile in secure storage.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "HMedic clinic platform API. Generated from packages/contracts (do not edit the JSON by hand). Business routes live under /api/v1; health routes at the root.",
    "title": "HMedic API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getHealthLive",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLive"
                }
              }
            },
            "description": "Alive"
          }
        },
        "summary": "Process liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getHealthReady",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReady"
                }
              }
            },
            "description": "Ready or degraded"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReady"
                }
              }
            },
            "description": "Unavailable"
          }
        },
        "summary": "Readiness (DB, job lag on the worker)",
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local development",
      "url": "http://localhost:3000"
    }
  ],
  "webhooks": {}
}
