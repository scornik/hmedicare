// ---------------------------------------------------------------- 0007 encounters
// DATABASE-IMPLEMENTATION.md §3.7. The first tables that hold clinical records, so the invariants that
// matter here are immutability and attribution rather than throughput.

model Encounter {
  /// @ascii
  id                     String    @id @db.VarChar(36)
  /// @ascii
  tenantId               String    @map("tenant_id") @db.VarChar(36)
  /// @ascii
  patientId              String    @map("patient_id") @db.VarChar(36)
  /// @ascii
  doctorProfileId        String    @map("doctor_profile_id") @db.VarChar(36)
  /// @ascii
  chamberId              String    @map("chamber_id") @db.VarChar(36)
  /// @ascii
  serialId               String    @map("serial_id") @db.VarChar(36)
  /// @ascii
  appointmentId          String?   @map("appointment_id") @db.VarChar(36)
  /// Set when the acting doctor was covering for the assigned one (AUTHORIZATION-MATRIX §3).
  /// @ascii
  coveringDoctorProfileId String?  @map("covering_doctor_profile_id") @db.VarChar(36)
  /// @ascii
  doctorCoverageId       String?   @map("doctor_coverage_id") @db.VarChar(36)
  /// True for an encounter backfilled from an ADR-021 interim transition, which has no note.
  legacyInterim          Boolean   @default(false) @map("legacy_interim")
  /// @ascii
  careMode               String    @map("care_mode") @db.VarChar(16)
  /// @ascii
  status                 String    @db.VarChar(20)
  startedAt              DateTime  @map("started_at") @db.DateTime(3)
  interruptedAt          DateTime? @map("interrupted_at") @db.DateTime(3)
  /// @ascii
  interruptionReason     String?   @map("interruption_reason") @db.VarChar(32)
  resumedAt              DateTime? @map("resumed_at") @db.DateTime(3)
  completedAt            DateTime? @map("completed_at") @db.DateTime(3)
  /// @ascii
  completionReason       String?   @map("completion_reason") @db.VarChar(32)
  enteredInErrorReason   String?   @map("entered_in_error_reason") @db.VarChar(300)
  createdAt              DateTime  @map("created_at") @db.DateTime(3)
  updatedAt              DateTime  @map("updated_at") @db.DateTime(3)
  /// @ascii
  createdByUserId        String?   @map("created_by_user_id") @db.VarChar(36)
  /// @ascii
  updatedByUserId        String?   @map("updated_by_user_id") @db.VarChar(36)
  rowVersion             Int       @default(1) @map("row_version")

  // Composite foreign keys reference `(tenant_id, id)`, which needs an index of its own — every
  // tenant-scoped parent in this schema carries the same one.
  @@unique([tenantId, id], map: "uq_encounters_tenant_id")
  @@index([tenantId, patientId, startedAt], map: "ix_encounters_patient")
  @@index([tenantId, doctorProfileId, status], map: "ix_encounters_doctor_status")
  @@map("encounters")
}

model EncounterParticipant {
  /// @ascii
  id                   String    @id @db.VarChar(36)
  /// @ascii
  tenantId             String    @map("tenant_id") @db.VarChar(36)
  /// @ascii
  encounterId          String    @map("encounter_id") @db.VarChar(36)
  /// @ascii
  participantType      String    @map("participant_type") @db.VarChar(16)
  /// @ascii
  participantUserId    String?   @map("participant_user_id") @db.VarChar(36)
  /// @ascii
  participantPatientId String?   @map("participant_patient_id") @db.VarChar(36)
  /// @ascii
  role                 String    @db.VarChar(16)
