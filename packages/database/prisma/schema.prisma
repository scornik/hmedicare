// HMedic database schema (DATABASE-IMPLEMENTATION.md). MariaDB 10.6 feature floor (ADR-014).
//
// Conventions:
// - Field docs `/// @ascii` mark VARCHAR columns that the migration normalizer converts to
//   `CHARACTER SET ascii COLLATE ascii_bin` (ids, codes, keys, hashes).
// - Generated columns, table-level CHECKs and foreign keys are NOT modelled here. They live in
//   sql/constraints/<table>.sql and are appended to migrations by `db:migration:normalize`.
// - Append-only tables (audit_logs, platform_gate_decisions, sms_balance_snapshots) are written through
//   insert-only repositories; eslint hmedic/no-append-only-mutation forbids updates/deletes.
// - Stage 4 scope: migrations 0001, 0002, 0003, 0014 (checkpoints only), 0015, 0016.

// Prisma 6 with the Rust library engine, not 7's WebAssembly query compiler: the deployment target runs
// Node under LiteSpeed's Passenger wrapper, which cannot instantiate the WASM module (ADR-022). Driver
// adapters are kept, so `initSql` still applies the ADR-014 session settings to every connection.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  // `native` builds for the developer machine and CI; the plan is CloudLinux EL8 with OpenSSL 1.1.1k.
  binaryTargets   = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- 0001 platform_jobs

model SingletonLock {
  /// @ascii
  name           String   @id @db.VarChar(128)
  /// @ascii
  holder         String   @db.VarChar(128)
  leaseExpiresAt DateTime @map("lease_expires_at") @db.DateTime(3)
  updatedAt      DateTime @map("updated_at") @db.DateTime(3)

  @@map("singleton_locks")
}

model Job {
  /// @ascii
  id             String    @id @db.VarChar(36)
  /// @ascii
  tenantId       String?   @map("tenant_id") @db.VarChar(36)
  /// @ascii
  queue          String    @db.VarChar(64)
  /// @ascii
  type           String    @db.VarChar(96)
  payload        Json
  /// @ascii
  status         String    @db.VarChar(24)
  priority       Int       @default(100) @db.SmallInt
  runAt          DateTime  @map("run_at") @db.DateTime(3)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8) @map("max_attempts")
  /// @ascii
  concurrencyKey String?   @map("concurrency_key") @db.VarChar(128)
  /// @ascii
  lockedBy       String?   @map("locked_by") @db.VarChar(128)
  lockedAt       DateTime? @map("locked_at") @db.DateTime(3)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.DateTime(3)
  /// @ascii
  lastErrorClass String?   @map("last_error_class") @db.VarChar(64)
  /// @ascii
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(191)
  /// @ascii
  correlationId  String    @map("correlation_id") @db.VarChar(36)
  /// @ascii
  causationId    String?   @map("causation_id") @db.VarChar(36)
  createdAt      DateTime  @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @map("updated_at") @db.DateTime(3)
  finishedAt     DateTime? @map("finished_at") @db.DateTime(3)

  @@unique([queue, idempotencyKey], map: "uq_jobs_queue_idem")
  @@index([queue, status, priority, runAt], map: "ix_jobs_claim")
  @@index([status, leaseExpiresAt], map: "ix_jobs_reclaim")
  @@index([tenantId, createdAt], map: "ix_jobs_tenant")
  @@index([concurrencyKey, status], map: "ix_jobs_concurrency")
  @@map("jobs")
}

model DeadLetter {
  /// @ascii
  id               String    @id @db.VarChar(36)
  /// @ascii
  jobId            String    @unique(map: "uq_dead_letters_job") @map("job_id") @db.VarChar(36)
  /// @ascii
  tenantId         String?   @map("tenant_id") @db.VarChar(36)
  /// @ascii
  queue            String    @db.VarChar(64)
  /// @ascii
  type             String    @db.VarChar(96)
  payload          Json
  attempts         Int
  /// @ascii
  lastErrorClass   String    @map("last_error_class") @db.VarChar(64)
  failedAt         DateTime  @map("failed_at") @db.DateTime(3)
  replayedAt       DateTime? @map("replayed_at") @db.DateTime(3)
  /// @ascii
  replayedByUserId String?   @map("replayed_by_user_id") @db.VarChar(36)
  /// @ascii
  replayJobId      String?   @map("replay_job_id") @db.VarChar(36)

  @@index([queue, failedAt], map: "ix_dead_letters_queue")
  @@map("dead_letters")
}

model JobConcurrencyLease {
  /// @ascii
  concurrencyKey String   @map("concurrency_key") @db.VarChar(128)
  slotNo         Int      @map("slot_no") @db.SmallInt
  /// @ascii
  jobId          String   @unique(map: "uq_job_concurrency_leases_job") @map("job_id") @db.VarChar(36)
  leaseExpiresAt DateTime @map("lease_expires_at") @db.DateTime(3)

  @@id([concurrencyKey, slotNo])
  @@map("job_concurrency_leases")
}

model RateLimitCounter {
  /// @ascii
  scope         String   @db.VarChar(64)
  /// @ascii
  subjectHash   String   @map("subject_hash") @db.VarChar(64)
  windowStart   DateTime @map("window_start") @db.DateTime(3)
  windowSeconds Int      @map("window_seconds")
  count         Int      @db.UnsignedInt
  expiresAt     DateTime @map("expires_at") @db.DateTime(3)

  @@id([scope, subjectHash, windowStart])
  @@index([expiresAt], map: "ix_rate_limit_counters_expires")
  @@map("rate_limit_counters")
}

