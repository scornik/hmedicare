  @@index([tenantId, encounterId], map: "ix_encounter_participants_encounter")
  @@map("encounter_participants")
}

/// The single mutable draft per encounter (resolves C-10). Autosave writes here under `row_version`;
/// signing copies it into an append-only version row.
model EncounterNote {
  /// @ascii
  id                    String   @id @db.VarChar(36)
  /// @ascii
  tenantId              String   @map("tenant_id") @db.VarChar(36)
  /// @ascii
  encounterId           String   @map("encounter_id") @db.VarChar(36)
  /// @ascii
  authorDoctorProfileId String   @map("author_doctor_profile_id") @db.VarChar(36)
  /// @ascii
  status                String   @db.VarChar(16)
  chiefComplaint        String?  @map("chief_complaint") @db.LongText
  history               String?  @db.LongText
  examination           String?  @db.LongText
  assessment            String?  @db.LongText
  plan                  String?  @db.LongText
  extensions            Json?
  schemaVersion         Int      @default(1) @map("schema_version") @db.SmallInt
  sectionSources        Json     @map("section_sources")
  lastSignedRevision    Int?     @map("last_signed_revision")
  createdAt             DateTime @map("created_at") @db.DateTime(3)
  updatedAt             DateTime @map("updated_at") @db.DateTime(3)
  /// @ascii
  createdByUserId       String?  @map("created_by_user_id") @db.VarChar(36)
  /// @ascii
  updatedByUserId       String?  @map("updated_by_user_id") @db.VarChar(36)
  rowVersion            Int      @default(1) @map("row_version")

  @@unique([tenantId, id], map: "uq_encounter_notes_tenant_id")
  @@index([tenantId, encounterId], map: "ix_encounter_notes_encounter")
  @@map("encounter_notes")
}

/// Append-only and hash-chained per encounter. Nothing updates or deletes a row here; a correction is a
/// new revision that carries its reason.
model EncounterNoteVersion {
  /// @ascii
  id                       String   @id @db.VarChar(36)
  /// @ascii
  tenantId                 String   @map("tenant_id") @db.VarChar(36)
  /// @ascii
  encounterId              String   @map("encounter_id") @db.VarChar(36)
  /// @ascii
  noteId                   String   @map("note_id") @db.VarChar(36)
  revision                 Int      @db.UnsignedInt
  /// @ascii
  signedByDoctorProfileId  String   @map("signed_by_doctor_profile_id") @db.VarChar(36)
  signedAt                 DateTime @map("signed_at") @db.DateTime(3)
  chiefComplaint           String?  @map("chief_complaint") @db.LongText
  history                  String?  @db.LongText
  examination              String?  @db.LongText
  assessment               String?  @db.LongText
  plan                     String?  @db.LongText
  extensions               Json?
  sectionSources           Json     @map("section_sources")
  schemaVersion            Int      @default(1) @map("schema_version") @db.SmallInt
  correctionReason         String?  @map("correction_reason") @db.VarChar(500)
  supersedesRevision       Int?     @map("supersedes_revision")
  /// @ascii
  contentSha256            String   @map("content_sha256") @db.VarChar(64)
  /// @ascii
  prevRowHash              String?  @map("prev_row_hash") @db.VarChar(64)
  /// @ascii
  rowHash                  String   @map("row_hash") @db.VarChar(64)
  createdAt                DateTime @map("created_at") @db.DateTime(3)

  @@unique([tenantId, encounterId, revision], map: "uq_encounter_note_versions_revision")
  @@unique([tenantId, id], map: "uq_encounter_note_versions_tenant_id")
  @@index([tenantId, noteId], map: "ix_encounter_note_versions_note")
  @@map("encounter_note_versions")
}
