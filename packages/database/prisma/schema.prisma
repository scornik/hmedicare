model AuditLog {
  /// @ascii
  id                     String   @id @db.VarChar(36)
  /// @ascii
  tenantId               String?  @map("tenant_id") @db.VarChar(36)
  seq                    BigInt   @db.UnsignedBigInt
  /// @ascii
  chainKey               String   @map("chain_key") @db.VarChar(64)
  /// @ascii
  actorUserId            String?  @map("actor_user_id") @db.VarChar(36)
  /// @ascii
  actorType              String   @map("actor_type") @db.VarChar(16)
  /// @ascii
  actingAs               String?  @map("acting_as") @db.VarChar(16)
  /// @ascii
  onBehalfOfPatientId    String?  @map("on_behalf_of_patient_id") @db.VarChar(36)
  /// @ascii
  action                 String   @db.VarChar(96)
  /// @ascii
  resourceType           String   @map("resource_type") @db.VarChar(64)
  /// @ascii
  resourceId             String?  @map("resource_id") @db.VarChar(36)
  /// @ascii
  outcome                String   @db.VarChar(16)
  /// @ascii
  requestId              String?  @map("request_id") @db.VarChar(36)
  /// @ascii
  correlationId          String?  @map("correlation_id") @db.VarChar(36)
  /// @ascii
  ipHash                 String?  @map("ip_hash") @db.VarChar(64)
  /// @ascii
  userAgentHash          String?  @map("user_agent_hash") @db.VarChar(64)
  metadata               Json
  rolePermissionsVersion Int?     @map("role_permissions_version")
  occurredAt             DateTime @map("occurred_at") @db.DateTime(3)
  /// @ascii
  prevRowHash            String?  @map("prev_row_hash") @db.VarChar(64)
  /// @ascii
  rowHash                String   @map("row_hash") @db.VarChar(64)

  @@unique([chainKey, seq], map: "uq_audit_logs_chain_seq")
  @@index([tenantId, resourceType, resourceId, occurredAt], map: "ix_audit_logs_resource")
  @@index([tenantId, actorUserId, occurredAt], map: "ix_audit_logs_actor")
  @@map("audit_logs")
}

