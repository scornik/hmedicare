{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "medication_id": {
      "type": "string"
    },
    "record_key": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "unit_price_bdt": {
      "type": "number",
      "minimum": 0
    },
    "pack_price_bdt": {
      "type": "number",
      "minimum": 0
    },
    "price_label": {
      "type": "string"
    },
    "is_official_mrp": {
      "type": "boolean"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "medication_id",
    "record_key",
    "source_id",
    "source_url",
    "is_official_mrp",
    "observed_at"
  ],
  "additionalProperties": false
}