# HMedic — environment template (ENVIRONMENT-CONTRACT.md). Stage 4 sections only.
# Local development: run `node scripts/generate-local-secrets.mjs` to create a filled-in `.env`
# (gitignored) with freshly generated secrets. Never commit real values; placeholders look like <...>.

# ---- runtime ----
APP_ENV=development
APP_VERSION=dev
PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173
WORKER_PUBLIC_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Trusted reverse proxies (IPs/CIDRs or loopback|linklocal|uniquelocal); empty = ignore X-Forwarded-*.
TRUST_PROXY=
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_LOCALE=bn-BD
LOG_LEVEL=debug
LOG_HASH_PEPPER=<32+ random bytes, base64>

# ---- database / jobs (local compose: pnpm infra:up) ----
DATABASE_URL=mariadb://hmedic_app:<local compose password>@127.0.0.1:3306/hmedic_dev
DATABASE_POOL_MAX=10
DB_LOCK_WAIT_TIMEOUT_SECONDS=5
MIGRATE_ON_STARTUP=false
JOB_RUNNER_MODE=off
JOB_CLAIM_STRATEGY=skip_locked
INTERNAL_CRON_TOKEN=<32+ random bytes, base64>
INTERNAL_METRICS_TOKEN=<32+ random bytes, base64>
IDEMPOTENCY_TTL_HOURS=24

# ---- auth / crypto ----
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=hmedic-api
JWT_ACCESS_TTL_SECONDS=600
JWT_SIGNING_KEY_ID=dev-jwt-1
JWT_SIGNING_PRIVATE_KEY=<Ed25519 PKCS#8 PEM, newlines as \n>
JWT_VERIFICATION_KEYS=<JSON map {"dev-jwt-1":"<SPKI PEM>"}>
REFRESH_TOKEN_PEPPER=<32+ random bytes, base64>
OTP_PEPPER=<32+ random bytes, base64>
RATE_LIMIT_PEPPER=<32+ random bytes, base64>
CSRF_SECRET=<32+ random bytes, base64>
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
OTP_PROVIDER=mock
OTP_TTL_SECONDS=180
# LOCAL only: cookies without the __Host- prefix / Secure flag for http://localhost (refused in staging/production).
AUTH_COOKIE_DEV_MODE=true
PUSH_TOKEN_KEK=<32 random bytes, base64>
PUSH_TOKEN_KEK_ID=dev-push-1
PROVIDER_CREDENTIAL_KEK=<32 random bytes, base64>
PROVIDER_CREDENTIAL_KEK_ID=dev-pc-1
PROVIDER_CREDENTIAL_FINGERPRINT_PEPPER=<32+ random bytes, base64>

# ---- SMS / OTP (ADR-018) ----
SMS_PROVIDER=mock
# Zaman IT (only with SMS_PROVIDER=zamanit; never in CI):
# ZAMANIT_BASE_URL=<provider base URL>
# ZAMANIT_API_KEY=<ZAMANIT_API_KEY>
# ZAMANIT_API_KEY_ISSUED_ON=<YYYY-MM-DD>
# ZAMANIT_SENDER_ID=<sender id>
# ZAMANIT_ALLOW_INSECURE_HTTP=false
# SMS-008 live smoke (LOCAL only, one message, never in CI):
# ZAMANIT_LIVE_SMOKE=false
# ZAMANIT_LIVE_SMOKE_TO=<DEVELOPER_PHONE_E164>

# ---- observability ----
OTEL_ENABLED=false

# ---- host probe (HOST-VERIFICATION-RUNBOOK; hPanel only) ----
# HOST_PROBE_TOKEN=<32+ chars>
# HOST_PROBE_DATABASE_URL=<dedicated probe database URL>
